# Docker Compose interpolation variables (copy to .env next to compose.yaml).
# Server secrets and model config go in server/.env (see server/.env.example).

# Hostname the browser uses; feeds CLIENT_DOMAIN, S3_PUBLIC_BASE_URL, the
# client's NEXT_PUBLIC_API_URL default and the containers' extra_hosts entry.
# compose.override.yaml turns it into https://${BASE_HOSTNAME} URLs (Caddy deploy).
BASE_HOSTNAME=localhost

# API URL compiled into the client image. Default:
# http://${BASE_HOSTNAME}:12001. Behind the host Caddy: https://${BASE_HOSTNAME}
# NEXT_PUBLIC_API_URL=

# Upload limit for both the server check and the client bundle.
# MAX_UPLOAD_SIZE_MB=50

# Emails that get is_admin on signup (compose default: admin@local.openpaper).
# ADMIN_EMAILS=
