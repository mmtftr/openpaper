# Server + ingest-worker configuration (read by app/settings.py).
# Copy to server/.env. Under docker compose, compose.yaml / compose.override.yaml
# set the database, S3, domain, cookie, ADMIN_EMAILS and MAX_UPLOAD_SIZE_MB
# values for the containers (the last two from the repo-root .env), overriding
# this file; the values below are the host-dev defaults (uvicorn on the host
# against the compose infra, see DEVELOPMENT.md).

# --- Database ------------------------------------------------------------------
# Host dev: postgres published on 5434 by compose.dev.yaml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/openpaper

# --- Auth / deployment -----------------------------------------------------------
# Browser origin of the client (CORS + login redirects).
CLIENT_DOMAIN=http://localhost:3000
# Comma-separated emails that get is_admin on signup.
ADMIN_EMAILS=
# Sign-in emails a 6-digit code via Resend. Unset: the code is printed to the
# server log instead (`docker compose logs server`).
RESEND_API_KEY=
# SECURE_COOKIES=false
# SESSION_COOKIE_DOMAIN=
MAX_UPLOAD_SIZE_MB=50

# --- S3 (MinIO in compose) -------------------------------------------------------
AWS_ACCESS_KEY_ID=openpaper
AWS_SECRET_ACCESS_KEY=openpaper-local
AWS_REGION=us-east-1
S3_BUCKET_NAME=openpaper-local
S3_ENDPOINT_URL=http://127.0.0.1:12010
# Base URL the browser uses for PDFs / previews / figure images.
S3_PUBLIC_BASE_URL=http://localhost:12010/openpaper-local
# Companion-repo snapshots. Unset: server/.repo_snapshots (compose uses a volume).
# REPO_STORAGE_DIR=

# --- LLM providers ---------------------------------------------------------------
# openai | codex_proxy | anthropic | gemini. Model slots without a pinned
# provider follow it (app/llm/model_slots.py; per-slot overrides live in
# Settings -> Models).
DEFAULT_LLM_PROVIDER=openai

# OpenAI, or Azure OpenAI with AZURE_OPENAI=true (OPENAI_API_KEY is then the
# Azure key and model ids are Azure deployment names). *_MODEL / *_FAST_MODEL
# fill the slots' "default" / "fast" roles; *_MODELS is the chat picker's
# list as CSV of `id` or `id|Display Name`.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_MODELS=
AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Any other OpenAI-compatible endpoint (a local proxy, self-hosted gateway, ...)
# as its own LLMProvider.CODEX_PROXY, distinct from OPENAI/Azure above. Only
# registers when CODEX_PROXY_BASE_URL is set. Its default model ids match
# OpenAI's own (gpt-5.5, ...) - fine to run alongside OPENAI/Azure even with
# overlapping ids: the model picker sends {id, provider} together, so
# resolve_model_for_provider() disambiguates correctly. Only a caller that
# passes a model id with no provider hits the ambiguous resolve_model()
# fallback, which prefers whichever provider registered first (OPENAI).
CODEX_PROXY_API_KEY=
CODEX_PROXY_BASE_URL=
CODEX_PROXY_MODEL=gpt-5.5
CODEX_PROXY_FAST_MODEL=gpt-5.4-mini
CODEX_PROXY_MODELS=

# Anthropic / Gemini equivalents (unset models fall back to built-in defaults).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FAST_MODEL=
GEMINI_MODELS=

# JSON object of per-model capability overrides (app/llm/model_registry.py).
# MODEL_OVERRIDES=

# --- Ingest ----------------------------------------------------------------------
# Mistral OCR for the ingest worker's `ocr` stage. Chat, figures, outline and
# AI highlights depend on it; unset, the stage fails with a readable reason.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-1
# MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
# MISTRAL_OCR_BATCH_PAGES=16
# Page render DPI for the ocr_repair stage's vision calls.
# OPENAI_OCR_REPAIR_DPI=220

# --- Outbound APIs ---------------------------------------------------------------
# Discover search.
EXA_API_KEY=
# OpenAlex (discover, metadata lookup, citation resolution).
OPENALEX_API_KEY=
# Crossref / OpenAlex "polite pool" contact address (optional).
CONTACT_EMAIL=

# --- Observability / process -----------------------------------------------------
# Pydantic Logfire for LLM calls, FastAPI and track_event(). Unset = no-op.
LOGFIRE_TOKEN=
# gunicorn (server container only): worker count and log level.
# WEB_CONCURRENCY=3
# GUNICORN_LOG_LEVEL=info
