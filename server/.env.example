# Required configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openpaper
OPENAI_API_KEY=your-openai-or-azure-api-key-here

# Optional: comma-separated list of email addresses that auto-receive admin
# privileges (and an unlimited subscription) on signup.
ADMIN_EMAILS=

# Optional: standard OpenAI / OpenAI-compatible config
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini

# Set AZURE_OPENAI=true to use Azure OpenAI. The OPENAI_API_KEY env var is the
# Azure key in this mode; AZURE_OPENAI_ENDPOINT is required. Strict structured
# outputs are automatically patched for Azure's stricter JSON-schema rules.
AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional: explicit default LLM provider (gemini | openai | groq | cerebras |
# anthropic). Defaults to openai. Hardcoded fall-throughs in the codebase
# (e.g. evidence-gathering picking CEREBRAS) silently fall back to the default
# when the requested provider isn't configured.
DEFAULT_LLM_PROVIDER=openai

# Optional: other LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
ANTHROPIC_API_KEY=

# Optional: PostHog telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional: discover/explore search
EXA_API_KEY=
OPENALEX_API_KEY=

# Local-stack defaults. Compose overrides these for containers.
CLIENT_DOMAIN=http://localhost:3000
API_DOMAIN=http://localhost:8000
WEBHOOK_BASE_URL=http://server:8000
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_API_URL=http://jobs-api:8001

# S3-compatible storage. For docker compose this points at MinIO.
AWS_ACCESS_KEY_ID=openpaper
AWS_SECRET_ACCESS_KEY=openpaper-local
AWS_REGION=us-east-1
S3_BUCKET_NAME=openpaper-local
CLOUDFLARE_BUCKET_NAME=localhost:9000/openpaper-local
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/openpaper-local
