# Required configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openpaper
OPENAI_API_KEY=your-openai-or-azure-api-key-here

# Optional: comma-separated list of email addresses that auto-receive admin
# privileges on signup.
ADMIN_EMAILS=

# Optional: standard OpenAI config (real OpenAI, or Azure - see AZURE_OPENAI
# below). *_FAST_MODEL is used behind the scenes for cheap calls (e.g.
# chat-title generation from the first message). Pickerable models come from
# OPENAI_MODELS (CSV of `id|Name`).
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_MODELS=

# Optional: any other OpenAI-compatible endpoint (a local proxy, self-hosted
# gateway, ...) as its own LLMProvider.CODEX_PROXY, distinct from OPENAI/Azure
# above. Only registers when CODEX_PROXY_BASE_URL is set. Its default model
# ids match OpenAI's own (gpt-5.5, ...) - fine to run alongside OPENAI/Azure
# even with overlapping ids: the model picker sends {id, provider} together,
# so resolve_model_for_provider() disambiguates correctly. Only a caller that
# passes a model id with no provider hits the ambiguous resolve_model()
# fallback, which prefers whichever provider registered first (OPENAI).
CODEX_PROXY_API_KEY=
CODEX_PROXY_BASE_URL=
CODEX_PROXY_MODEL=gpt-5.5
CODEX_PROXY_FAST_MODEL=gpt-5.4-mini
CODEX_PROXY_MODELS=

# Anthropic / Gemini equivalents. ANTHROPIC_MODELS / GEMINI_MODELS take the
# same `id|Name,id|Name` CSV form.
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_MODELS=
GEMINI_MODEL=
GEMINI_FAST_MODEL=
GEMINI_MODELS=

# Set AZURE_OPENAI=true to use Azure OpenAI. The OPENAI_API_KEY env var is the
# Azure key in this mode; AZURE_OPENAI_ENDPOINT is required. Strict structured
# outputs are automatically patched for Azure's stricter JSON-schema rules.
AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional: explicit default LLM provider (gemini | openai | codex_proxy |
# groq | cerebras | anthropic). Defaults to openai. Hardcoded fall-throughs in
# the codebase (e.g. evidence-gathering picking CEREBRAS) silently fall back
# to the default when the requested provider isn't configured.
DEFAULT_LLM_PROVIDER=openai

# Optional: other LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
ANTHROPIC_API_KEY=

# Optional: Mistral OCR. When set, the jobs container prefers direct Mistral
# OCR for PDF parsing and falls back to pymupdf4llm on failure. Surfaced here
# so docker-compose can pass it through to the jobs service.
MISTRAL_API_KEY=

# Optional: Pydantic Logfire observability for LLM calls, FastAPI, and Celery.
# Also receives the structured events emitted by the in-app track_event() helper
# (formerly PostHog). When LOGFIRE_TOKEN is unset, instrumentation is a no-op
# (send_to_logfire="if-token-present"), so leaving this blank is fine for
# self-hosted setups.
LOGFIRE_TOKEN=

# Optional: discover/explore search
EXA_API_KEY=
OPENALEX_API_KEY=

# Local-stack defaults. Compose overrides these for containers.
CLIENT_DOMAIN=http://localhost:3000
API_DOMAIN=http://localhost:8000
WEBHOOK_BASE_URL=http://server:8000
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_API_URL=http://jobs-api:8001

# S3-compatible storage. For docker compose this points at MinIO.
AWS_ACCESS_KEY_ID=openpaper
AWS_SECRET_ACCESS_KEY=openpaper-local
AWS_REGION=us-east-1
S3_BUCKET_NAME=openpaper-local
CLOUDFLARE_BUCKET_NAME=localhost:9000/openpaper-local
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/openpaper-local
MAX_UPLOAD_SIZE_MB=50
