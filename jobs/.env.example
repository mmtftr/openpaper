CELERY_BROKER_URL=pyamqp://guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Required: OpenAI (or Azure OpenAI) API key. Set AZURE_OPENAI=true to switch
# the client to AzureOpenAI; OPENAI_API_KEY is the Azure key in that mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini

AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# S3-compatible storage. For docker compose this points at MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
CLOUDFLARE_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
