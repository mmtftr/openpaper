# Client configuration for `yarn dev` / `yarn build` on the host (copy to
# client/.env.local). Both values are compiled into the bundle at build time.
# The Docker image gets them as build args from compose.yaml (which reads the
# repo-root .env), not from this file.

# Base URL of the API. Empty = same origin (relative /api/... URLs, e.g. behind
# one Caddy host). Host dev: the uvicorn port, e.g. http://localhost:8003.
NEXT_PUBLIC_API_URL=http://localhost:8003

# Client-side upload size check; keep in sync with the server's MAX_UPLOAD_SIZE_MB.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
